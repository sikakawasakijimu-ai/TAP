<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp" />

        <Button
            android:id="@+id/openA11y"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="① ユーザー補助で ColorTap を有効にする" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="タップする対象 (上ほど優先)"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="動作中に画面の「＋色」「＋画像」でも追加できます。↑↓で順番を変更。"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/targets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/colorInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="#FF0000"
                android:inputType="textNoSuggestions|textCapCharacters"
                android:maxLength="7" />

            <Button
                android:id="@+id/addColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="色を追加" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/tapAll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="見つけた対象をすべてタップする (OFF: 見つかった中で一番優先の1か所だけ)" />

        <TextView
            android:id="@+id/toleranceLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <SeekBar
            android:id="@+id/tolerance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="チェック間隔 (ミリ秒)" />

        <EditText
            android:id="@+id/interval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="色の最小サイズ (小さいノイズを無視。大きいほど厳しい)" />

        <EditText
            android:id="@+id/minHits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="画像の一致率 (%) (小さいほどゆるく判定)" />

        <EditText
            android:id="@+id/matchPct"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />

        <Button
            android:id="@+id/start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="② 開始" />

        <Button
            android:id="@+id/stop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="停止" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="開始すると画面の録画許可を求められます。「画面全体」を選んでください。\n対象が空のまま開始して、画面の「＋色」「＋画像」で追加してもOKです。\n動作中は画面上の「■ 停止」ボタン、または通知から止められます。" />
    </LinearLayout>
</ScrollView>
