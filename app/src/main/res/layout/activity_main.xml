<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp" />

        <Button
            android:id="@+id/openA11y"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="① ユーザー補助で ColorTap を有効にする" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="タップする色 (複数可。カンマか改行で区切る)\n動作中に画面の「＋色」→ 画面をタップでも追加できます" />

        <EditText
            android:id="@+id/color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="#FF0000, #00FF00"
            android:inputType="textNoSuggestions|textCapCharacters|textMultiLine" />

        <LinearLayout
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:orientation="horizontal" />

        <CheckBox
            android:id="@+id/tapEachColor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="色ごとにタップする (OFF: 一番大きく見つかった1か所だけタップ)" />

        <TextView
            android:id="@+id/toleranceLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <SeekBar
            android:id="@+id/tolerance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="チェック間隔 (ミリ秒)" />

        <EditText
            android:id="@+id/interval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="最小サイズ (小さいノイズを無視。大きいほど厳しい)" />

        <EditText
            android:id="@+id/minHits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />

        <Button
            android:id="@+id/start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="② 開始" />

        <Button
            android:id="@+id/stop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="停止" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="開始すると画面の録画許可を求められます。「画面全体」を選んでください。\n色が空のまま開始して、画面の「＋色」で色を選んでもOKです。\n動作中は画面上の「■ 停止」ボタン、または通知から止められます。" />
    </LinearLayout>
</ScrollView>
